NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical app origin — used by the server-side Supabase proxy to route
# auth requests through /api/sb/ instead of hitting supabase.co directly.
# Required on VPS deployments; prevents 502 on Google OAuth callback.
# Production: https://subcuro.app
# Local dev:  http://localhost:3000
NEXT_PUBLIC_APP_URL=

# Серверный ключ OpenRouter (не NEXT_PUBLIC — не попадает в браузер)
OPENROUTER_API_KEY=

# Upstash Redis — rate limiting для AI и scan/file эндпоинтов
# Оставьте пустыми для локальной разработки (rate limiting отключается автоматически)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Секрет для подписи ссылок отписки в письмах (HMAC-SHA256)
# Генерация: openssl rand -hex 32
UNSUBSCRIBE_SECRET=
