# Real project URL — required for PKCE cookie names (do not use sb.subcuro.app here)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Russia/VPS: nginx mirror for API traffic only
# NEXT_PUBLIC_SUPABASE_PROXY_URL=https://sb.subcuro.app

# Server-side Supabase proxy (only for self-hosted VPS where supabase.co is blocked).
# Vercel: leave INTERNAL_APP_URL and NEXT_PUBLIC_APP_URL empty.
# VPS behind nginx: prefer loopback so OAuth does not round-trip through nginx:
#   INTERNAL_APP_URL=http://127.0.0.1:3000
# If the app is not on :3000, use your process port. Public URL fallback:
#   NEXT_PUBLIC_APP_URL=https://subcuro.app
INTERNAL_APP_URL=
NEXT_PUBLIC_APP_URL=
# Vercel + sb.subcuro.app nginx proxy: server OAuth uses sb without looping through subcuro.app
# SUPABASE_CALLBACK_PROXY_BASE_URL=https://sb.subcuro.app

# Яндекс OAuth — см. README "Вход через Яндекс/VK".
# Callback (redirect_uri), который нужно указать в настройках приложения на oauth.yandex.ru:
#   https://subcuro.app/auth/oauth/yandex
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# VK ID OAuth — см. README "Вход через Яндекс/VK".
# Callback (redirect_uri), который нужно указать в настройках приложения на id.vk.com:
#   https://subcuro.app/auth/oauth/vk
# client_secret в PKCE-флоу VK ID не используется.
VK_CLIENT_ID=

# Сервисная роль Supabase — для входа через Яндекс/VK (admin.generateLink).
# Supabase → Settings → API → service_role. Никогда не делать NEXT_PUBLIC, только сервер.
SUPABASE_SERVICE_ROLE_KEY=

# Серверный ключ OpenRouter (не NEXT_PUBLIC — не попадает в браузер)
OPENROUTER_API_KEY=

# Upstash Redis — rate limiting для AI и scan/file эндпоинтов
# Оставьте пустыми для локальной разработки (rate limiting отключается автоматически)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Секрет для подписи ссылок отписки в письмах (HMAC-SHA256)
# Генерация: openssl rand -hex 32
UNSUBSCRIBE_SECRET=
